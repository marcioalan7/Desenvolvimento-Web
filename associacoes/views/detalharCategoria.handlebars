<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalhar Categoria</title>
</head>
<body>
    <h1>{{categoria.tipo}}</h1>

    <label>Produtos contidos:</label>
    <ul>
        {{#each categoria.produtos}}
        <li><a href="/produtos/{{this.id}}">{{this.nome}}</a></li>
        {{/each}}
    </ul>
</body>
</html>