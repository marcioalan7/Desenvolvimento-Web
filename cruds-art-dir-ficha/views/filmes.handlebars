<h1>Filmes</h1>

<table border = '1'>
    <tr>
        <th>Nome</th>
        <th>Ano de Lançamento</th>
    </tr>

        {{#each filmes}}

    <tr>
        <td><a href = '/filmes/{{id}}'>{{nome}}</a></td>
        <td><a href = '/filmes/{{id}}'>{{anoLancamento}}</a></td>

        <td>
            <a href = '/editar/filmes/{{id}}'>Editar</a>

            <form action = '/deletar/filmes/{{id}}?_method=DELETE' method='POST'>
                <button type = 'submit'>Excluir</button>
            </form>
        </td>
    </tr>

    {{/each}}

</table>

<a href = '/'>Home</a>