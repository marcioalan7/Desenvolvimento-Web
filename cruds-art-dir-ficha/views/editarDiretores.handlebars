<form action = '/editar/diretores/{{diretor.id}}?_method=PUT' method='POST'>

    <label>Nome</label>
    <input type = 'text' name = 'nome' value = '{{diretor.nome}}'>
    
    <label>Ano de Nascimento</label>
    <input type = 'text' name = 'anoNascimento' value = '{{diretor.anoNascimento}}'>

     <label>Está em Atividade?</label>

    <select name="atv">
        <option value="Sim">Sim</option>
        <option value="Não">Não</option>
    </select>

    <button type = 'submit'>Editar</button>

</form>