<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pessoas</title>
</head>
<body>
    <h1>Pessoas</h1>
    <a href="/">Home</a>
    <br>
    <a href = '/cadastrarPessoa'>Cadastre nova pessoa</a>

    <table border="1">

        <tr>
            <th>Nome</th>
            <th>Ações</th>
        </tr>

        {{#each pessoas}}

        <tr>

            <td>
                {{nome}}
            </td>

            <td>
                <a href="/pessoa/{{id}}">
                    Detalhar Pessoa
                </a>

                <a href="/cadastrarPessoa/{{id}}/passaporte">
                    Cadastrar Passaporte
                </a>
            </td>

        </tr>

        {{/each}}

    </table>

</body>
</html>