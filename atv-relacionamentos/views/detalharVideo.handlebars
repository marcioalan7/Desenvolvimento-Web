<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Detalhar Vídeo</title>
</head>

<body>

    <h1>{{video.titulo}}</h1>


    <p>{{video.descricao}}</p>

    <h3>Criador:</h3>

    <a href="/criador/{{video.criador.id}}">
        {{video.criador.nome}}
    </a>

    <h3>Hastags:</h3>

    <ul>
        {{#each video.hastags}}
            <li>#{{nome}}</li>
        {{/each}}
    </ul>

    <br>
    <a href = '/'>Home</a>

</body>
</html>