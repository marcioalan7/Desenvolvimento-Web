<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastrar Autor e Livros</title>
</head>
<body>
    <h1>Cadastrar Autor e Livros</h1>

    <form action="/cadastrarAutorLivros" method="POST">

        <h2>Autor</h2>

        <label>Nome:</label>
        <input type="text" name="nomeAutor" required>

        <h2>Livro 1</h2>

        <label>Título:</label>
        <input type="text" name="tituloLivro1" required>

        <label>Ano de Publicação:</label>
        <input type = 'number' name = 'anoLivro1' required>

        <h2>Livro 2</h2>

        <label>Título:</label>
        <input type="text" name="tituloLivro2" required>

        <label>Ano de Publicação:</label>
        <input type = 'number' name = 'anoLivro2' required>

        <br><br>

        <button type="submit">Cadastrar Autor e Livros</button>

    </form>

</body>
</html>