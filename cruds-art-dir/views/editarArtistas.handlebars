<form action = '/editar/artistas/{{artista.id}}?_method=PUT' method='POST'>

    <label>Nome</label>
    <input type = 'text' name = 'nome' value = '{{artista.nome}}'>
    
    <label>Ano de Nascimento</label>
    <input type = 'text' name = 'anoNascimento' value = '{{artista.anoNascimento}}'>

    <label>Foto</label>
    <input type = 'text' name = 'foto' value = '{{artista.foto}}'>

    <label>Nome Artístico</label>
    <input type = 'text' name = 'nomeArtistico' value = '{{artista.nomeArtistico}}'>

    <label>Técnicass de Atuação</label>
    <input type = 'text' name = 'tecAtuacao' value = '{{artista.tecAtuacao}}'>

    <label>Está em Atividade?</label>

    <select name="atv">
        <option value="Sim">Sim</option>
        <option value="Não">Não</option>
    </select>

    <button type = 'submit'>Editar</button>

</form>